# AWS Deployment Configuration
# Copy this file to .env and fill in your values
# Then run: source .env && ./deploy.sh

# Stack Configuration
export STACK_NAME="rampart-production"
export AWS_REGION="us-east-1"

# Google OAuth (required)
# Get from: https://console.cloud.google.com/apis/credentials
export GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
export GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Database Configuration (required)
# Choose a strong password (minimum 8 characters)
export DB_PASSWORD="YourSecurePassword123!"

# EC2 Configuration (required)
# Must exist in your AWS region
export KEY_PAIR_NAME="rampart-key"

# Instance Type (optional, defaults to t3.medium)
# Options: t3.small, t3.medium, t3.large
# export INSTANCE_TYPE="t3.medium"

# Domain Name (optional)
# Leave empty if you don't have a domain
export DOMAIN_NAME=""

# Example with domain:
# export DOMAIN_NAME="rampart.yourdomain.com"

# ACM certificate ARN for the domain above, in the same region (required for HTTPS).
# Request/validate one first: https://console.aws.amazon.com/acm
# export ACM_CERTIFICATE_ARN="arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# SSH access (optional): CIDR allowed to reach port 22 on the instance.
# Defaults to this machine's current public IP (/32) when unset. Never use 0.0.0.0/0.
# export SSH_ALLOWED_CIDR="203.0.113.10/32"

# Google account emails granted the super-admin dashboard (comma-separated)
export SUPER_ADMIN_EMAILS="you@example.com"
